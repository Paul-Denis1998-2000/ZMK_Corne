#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define GAME 1
#define LWR 2
#define RSE 3
#define ADJ 4

&lt { quick_tap_ms = <200>; };
&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q      &kp W  &kp E  &kp R      &kp T  &kp Y        &kp U    &kp I  &kp O      &kp P     &kp LBKT  &kp RBKT
&kp A      &kp S  &kp D  &kp F      &kp G  &kp H        &kp J    &kp K  &kp L      &kp SEMI  &kp SQT   &kp BSPC
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp ESC
                         &kp LCTRL  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp LGUI
            >;
        };

        layer_1 {
            bindings = <
&kp TAB    &kp F1  &kp F2  &kp F3     &kp F4  &kp F5       &kp F6   &kp F7  &kp F8    &kp F9     &kp F10    &kp F11
&kp RALT   &kp N1  &kp N2  &kp N3     &kp N4  &kp N5       &kp N6   &kp N7  &kp N8    &kp N9     &kp N0     &kp DEL
&kp LSHFT  &trans  &trans  &trans     &trans  &trans       &trans   &trans  &trans    &kp MINUS  &kp EQUAL  &kp ESC
                           &kp LCTRL  &trans  &kp SPACE    &kp RET  &mo 3   &kp LGUI
            >;
        };

        layer_2 {
            bindings = <
&kp TAB    &kp INSERT       &kp UP          &trans       &trans  &kp PG_UP    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans  &trans
&kp LALT   &kp LEFT         &kp DOWN        &kp RIGHT    &trans  &kp PG_DN    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans  &trans  &kp BSPC
&kp LSHFT  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp C_PAUSE  &trans  &trans       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans  &kp ESC
                                            &kp LCTRL    &mo 3   &kp SPACE    &kp RET          &trans           &kp LGUI
            >;
        };

        layer_3 {
            bindings = <
&kp TAB    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans            &trans      &trans  &trans  &bt BT_CLR_ALL
&kp LALT   &trans        &trans        &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans  &kp DEL
&kp LCTRL  &trans        &trans        &trans        &trans        &bt BT_CLR      &trans          &trans            &trans      &trans  &trans  &kp ESC
                                       &kp LCTRL     &trans        &kp SPACE       &kp RET         &trans            &kp LGUI
            >;
        };
    };
};
